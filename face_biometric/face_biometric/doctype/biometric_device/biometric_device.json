{
	"name": "Biometric Device",
	"autoname": "BDEV-.#####",
	"naming_rule": "Expression (old style)",
	"track_changes": 1,
	"field_order": [
		"device_kind",
		"employee",
		"employee_name",
		"status",
		"column_break_a",
		"device_label",
		"location",
		"allow_offline",
		"registered_on",
		"last_seen",
		"section_key",
		"public_key"
	],
	"fields": [
		{
			"fieldname": "device_kind",
			"fieldtype": "Select",
			"label": "Device Kind",
			"options": "Personal\nKiosk",
			"default": "Personal",
			"reqd": 1,
			"set_only_once": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"description": "Personal: one employee's own phone. Kiosk: a shared phone at an entrance that anyone can punch in at."
		},
		{
			"fieldname": "employee",
			"fieldtype": "Link",
			"label": "Employee",
			"options": "Employee",
			"reqd": 0,
			"set_only_once": 1,
			"in_list_view": 1,
			"search_index": 1,
			"mandatory_depends_on": "eval:doc.device_kind!='Kiosk'",
			"depends_on": "eval:doc.device_kind!='Kiosk'"
		},
		{
			"fieldname": "employee_name",
			"fieldtype": "Data",
			"label": "Employee Name",
			"fetch_from": "employee.employee_name",
			"read_only": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "Active\nRevoked",
			"default": "Active",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "column_break_a",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "device_label",
			"fieldtype": "Data",
			"label": "Device Label"
		},
		{
			"fieldname": "location",
			"fieldtype": "Link",
			"label": "Location",
			"options": "Shift Location",
			"depends_on": "eval:doc.device_kind=='Kiosk'",
			"description": "Where this kiosk stands, for example Main Entrance."
		},
		{
			"fieldname": "registered_on",
			"fieldtype": "Datetime",
			"label": "Registered On",
			"read_only": 1
		},
		{
			"fieldname": "last_seen",
			"fieldtype": "Datetime",
			"label": "Last Seen",
			"read_only": 1
		},
		{
			"fieldname": "section_key",
			"fieldtype": "Section Break",
			"label": "Key"
		},
		{
			"fieldname": "public_key",
			"fieldtype": "Long Text",
			"label": "Public Key (ECDSA P-256, base64 SPKI)",
			"reqd": 1,
			"set_only_once": 1,
			"no_copy": 1
		},
		{
			"fieldname": "allow_offline",
			"fieldtype": "Check",
			"label": "Allow Offline Attendance",
			"default": "0",
			"depends_on": "eval:doc.device_kind=='Kiosk'",
			"description": "Lets this kiosk save face scans while it has no internet and send them later. Needs Allow Offline Attendance in Face Biometric Settings. Off by default."
		}
	],
	"permissions": [
		{
			"role": "HR Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"email": 1,
			"print": 1,
			"report": 1,
			"export": 1,
			"share": 1
		},
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"report": 1,
			"export": 1
		}
	],
	"creation": "2026-10-29 16:00:00.000000",
	"modified": "2026-10-29 16:00:00.000000",
	"modified_by": "Administrator",
	"owner": "Administrator",
	"module": "Face Biometric",
	"doctype": "DocType",
	"engine": "InnoDB",
	"custom": 0,
	"sort_field": "modified",
	"sort_order": "DESC"
}
