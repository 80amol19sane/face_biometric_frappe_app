{
	"name": "Face Verification Log",
	"autoname": "FVL-.YYYY.-.######",
	"naming_rule": "Expression (old style)",
	"field_order": [
		"employee",
		"device",
		"outcome",
		"method",
		"column_break_a",
		"similarity",
		"employee_checkin",
		"detail",
		"section_offline",
		"local_id",
		"record_hash",
		"column_break_offline",
		"recorded_at"
	],
	"fields": [
		{
			"fieldname": "employee",
			"fieldtype": "Link",
			"label": "Employee",
			"options": "Employee",
			"reqd": 0,
			"in_list_view": 1,
			"search_index": 1
		},
		{
			"fieldname": "device",
			"fieldtype": "Link",
			"label": "Device",
			"options": "Biometric Device",
			"in_list_view": 1
		},
		{
			"fieldname": "outcome",
			"fieldtype": "Select",
			"label": "Outcome",
			"reqd": 1,
			"in_list_view": 1,
			"in_standard_filter": 1,
			"search_index": 1,
			"options": "Matched\nNo Match\nBad Signature\nChallenge Failed\nLocked Out\nNo Active Template\nUnknown Face\nAmbiguous Face\nWrong PIN\nNo PIN\nPIN Disabled\nOffline Held\nOffline Duplicate\nOffline Approved\nOffline Rejected"
		},
		{
			"fieldname": "method",
			"fieldtype": "Select",
			"label": "Method",
			"options": "Face\nPIN",
			"default": "Face",
			"in_list_view": 1,
			"in_standard_filter": 1
		},
		{
			"fieldname": "column_break_a",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "similarity",
			"fieldtype": "Float",
			"label": "Similarity",
			"precision": "3"
		},
		{
			"fieldname": "employee_checkin",
			"fieldtype": "Link",
			"label": "Employee Checkin",
			"options": "Employee Checkin"
		},
		{
			"fieldname": "detail",
			"fieldtype": "Small Text",
			"label": "Detail",
			"read_only": 1
		},
		{
			"fieldname": "section_offline",
			"fieldtype": "Section Break",
			"label": "Offline scan"
		},
		{
			"fieldname": "local_id",
			"fieldtype": "Data",
			"label": "Scan ID",
			"read_only": 1,
			"search_index": 1,
			"description": "Random id the kiosk gave this scan. Sending the same scan twice is recognised by it."
		},
		{
			"fieldname": "record_hash",
			"fieldtype": "Data",
			"label": "Record Hash",
			"read_only": 1,
			"description": "Fingerprint of the scan. The next scan from the same kiosk must quote it, so a missing or reordered scan shows up."
		},
		{
			"fieldname": "column_break_offline",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "recorded_at",
			"fieldtype": "Datetime",
			"label": "Recorded At",
			"read_only": 1,
			"description": "When the person stood at the kiosk, worked out from the last server contact, not from the phone's own clock."
		}
	],
	"permissions": [
		{
			"role": "HR Manager",
			"read": 1,
			"report": 1,
			"export": 1
		},
		{
			"role": "System Manager",
			"read": 1,
			"report": 1,
			"export": 1
		}
	],
	"in_create": 1,
	"creation": "2026-10-29 16:00:00.000000",
	"modified": "2026-10-29 16:00:00.000000",
	"modified_by": "Administrator",
	"owner": "Administrator",
	"module": "Face Biometric",
	"doctype": "DocType",
	"engine": "InnoDB",
	"custom": 0,
	"sort_field": "modified",
	"sort_order": "DESC"
}
