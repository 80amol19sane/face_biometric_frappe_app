	"modified_by": "Administrator",
	"owner": "Administrator",
	"module": "Face Biometric",
	"doctype": "DocType",
	"engine": "InnoDB",
	"custom": 0,
	"sort_field": "modified",
	"sort_order": "DESC"
}
