{
	"name": "Face Biometric Settings",
	"issingle": 1,
	"field_order": [
		"match_threshold",
		"embedding_model",
		"column_break_a",
		"challenge_ttl_seconds",
		"section_lockout",
		"max_failed_attempts",
		"lockout_minutes",
		"section_enrolment",
		"require_enrolment_approval",
		"section_kiosk",
		"require_liveness",
		"identify_margin",
		"kiosk_return_seconds",
		"column_break_kiosk",
		"pin_enabled",
		"pin_min_length",
		"pin_max_length",
		"photo_retention_days"
	],
	"fields": [
		{
			"fieldname": "match_threshold",
			"fieldtype": "Float",
			"label": "Match Threshold",
			"default": "0.6",
			"reqd": 1,
			"precision": "3",
			"description": "Cosine similarity a face must reach to count as a match (0 to 1). Calibrate this against your model before relying on it."
		},
		{
			"fieldname": "embedding_model",
			"fieldtype": "Data",
			"label": "Embedding Model",
			"reqd": 1,
			"description": "Model id the phones use. Templates from another model are refused.",
			"default": "mobilefacenet-v1"
		},
		{
			"fieldname": "column_break_a",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "challenge_ttl_seconds",
			"fieldtype": "Int",
			"label": "Challenge Lifetime (seconds)",
			"default": "60",
			"reqd": 1
		},
		{
			"fieldname": "section_lockout",
			"fieldtype": "Section Break",
			"label": "Lockout"
		},
		{
			"fieldname": "max_failed_attempts",
			"fieldtype": "Int",
			"label": "Failed Attempts Before Lockout",
			"default": "5",
			"reqd": 1
		},
		{
			"fieldname": "lockout_minutes",
			"fieldtype": "Int",
			"label": "Lockout Minutes",
			"default": "15",
			"reqd": 1
		},
		{
			"fieldname": "section_enrolment",
			"fieldtype": "Section Break",
			"label": "Enrolment"
		},
		{
			"fieldname": "require_enrolment_approval",
			"fieldtype": "Check",
			"label": "Require HR Approval Of New Faces",
			"default": "1",
			"description": "Stops one employee enrolling another person's face under their own account."
		},
		{
			"fieldname": "section_kiosk",
			"fieldtype": "Section Break",
			"label": "Kiosk and PIN"
		},
		{
			"fieldname": "require_liveness",
			"fieldtype": "Check",
			"label": "Require Liveness Check",
			"default": "1",
			"description": "Kiosks ask for a head turn or smile before matching. The check runs on the phone, so it cannot be verified by the server."
		},
		{
			"fieldname": "identify_margin",
			"fieldtype": "Float",
			"label": "Match Margin",
			"default": "0.05",
			"precision": "3",
			"description": "How far the best match must beat the runner-up. Stops two similar faces being confused."
		},
		{
			"fieldname": "kiosk_return_seconds",
			"fieldtype": "Int",
			"label": "Return To Camera After (seconds)",
			"default": "5"
		},
		{
			"fieldname": "column_break_kiosk",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "pin_enabled",
			"fieldtype": "Check",
			"label": "Allow PIN Attendance",
			"default": "1"
		},
		{
			"fieldname": "pin_min_length",
			"fieldtype": "Int",
			"label": "Minimum PIN Length",
			"default": "4"
		},
		{
			"fieldname": "pin_max_length",
			"fieldtype": "Int",
			"label": "Maximum PIN Length",
			"default": "6"
		},
		{
			"fieldname": "photo_retention_days",
			"fieldtype": "Int",
			"label": "Keep Proof Photos (days)",
			"default": "30",
			"description": "PIN check-ins save a photo as proof. Older photos are deleted daily."
		}
	],
	"permissions": [
		{
			"role": "HR Manager",
			"read": 1,
			"write": 1
		},
		{
			"role": "System Manager",
			"read": 1,
			"write": 1
		}
	],
	"creation": "2026-10-29 16:00:00.000000",
